meta {
  name: Find Metrics By Name
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/metrics?start_date={{$randomDatePast}}&end_date={{$isoTimestamp}}&name={{metricName}}&page=1&size=20
  body: none
  auth: none
}

params:query {
  start_date: {{$randomDatePast}}
  end_date: {{$isoTimestamp}}
  name: {{metricName}}
  page: 1
  size: 20
}
