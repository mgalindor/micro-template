meta {
  name: Find Metrics
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/metrics?start_date={{$randomDatePast}}&end_date={{$isoTimestamp}}&tag=env:prod&page=1&size=20
  body: none
  auth: none
}

params:query {
  start_date: {{$randomDatePast}}
  end_date: {{$isoTimestamp}}
  tag: env:prod
  page: 1
  size: 20
}
